@echo off
title ABRASAX HEX BYPASS - SELF DECODING
color 0A
echo.
echo  [OSIRISBLXCK] HEX MODE BYPASS ENGINE
echo  [*] Self-decoding payload
echo.

:: === HEX PAYLOAD (certutil decode) ===
:: This bat decodes the hex below to a temp .bat and runs it
set 

set TMPFILE=%TEMP%\abraxas_bypass_%RANDOM%.bat

echo  [*] Decoding hex payload...
certutil -decodehex -f "%TEMP%" "%TMPFILE%" >nul 2>&1

:: Alternative: write hex directly if certutil fails
if not exist "%TMPFILE%" (
    echo  [*] Fallback: direct write from hex...
    for /f "tokens=*" %%a in ("%HEX%") do echo %%a
    echo @echo off > "%TMPFILE%"
    echo echo ABRASAX BYPASS LAUNCHED >> "%TMPFILE%"
    echo set ANTHROPIC_BASE_URL=http://127.0.0.1:1234/v1 >> "%TMPFILE%"
    echo set ANTHROPIC_API_KEY=sk-bypass-osirisblxck >> "%TMPFILE%"
    echo set CLAUDE_TELEMETRY_DISABLED=1 >> "%TMPFILE%"
    echo claude %%* >> "%TMPFILE%"
    echo pause >> "%TMPFILE%"
)

echo  [✓] Payload decoded. Launching...
echo.
call "%TMPFILE%" %*
echo.
echo  [*] Cleanup...
del "%TMPFILE%" 2>nul
pause

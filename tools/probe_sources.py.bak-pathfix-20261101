# Android Sensor types -> the field they populate in a published sample.
# Sourced from android.hardware.Sensor constants.
TYPE_NAMES = {
    1: ("accelerometer", "imu[0:3]"),
    2: ("magnetic_field", "mag[0:3]"),
    4: ("gyroscope", "imu[3:6]"),
    5: ("light", "env[1]"),

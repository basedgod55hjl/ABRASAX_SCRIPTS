"""ABRASAX HUD — borderless, always-on-top Dear ImGui overlay.

A translucent floating panel that renders the live synaptic-brain field and the
runtime's vital signs on top of every other window.

    python SCRIPTS/ui/abrasax_hud.py                # normal
    python SCRIPTS/ui/abrasax_hud.py --no-topmost   # don't force HWND_TOPMOST
    python SCRIPTS/ui/abrasax_hud.py --scale 1.25

Controls: drag anywhere on the panel to move it · Ctrl+T toggles always-on-top ·
Ctrl+H hides/shows · Esc quits.

Data: GET :9626/state + :9626/texture (brain facade), falling back to :9001/brain/*.
Log: LOGS/abrasax-hud.log (a 0-byte log with a running pid means "alive, no errors").
"""
from __future__ import annotations

import argparse
import base64
import ctypes
import json
import sys
import threading
import time
import urllib.request
from pathlib import Path

import glfw
import imgui
import numpy as np
from OpenGL import GL as gl
from imgui.integrations.glfw import GlfwRenderer

ROOT = Path("C:/ABRASAX")
LOG = ROOT / "LOGS" / "abrasax-hud.log"
STATE_KEYS = ("ok", "steps", "nodes", "mean_state", "grid_sha256", "backend", "persisted")

W, H = 470, 392
ACCENT = (0.486, 0.424, 0.941, 1.0)
OK = (0.180, 0.902, 0.627, 1.0)
BAD = (1.000, 0.373, 0.427, 1.0)


def log(msg: str) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a", encoding="utf-8") as fh:
        fh.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\n")


def get_json(path: str, timeout: float = 4.0):
    for base in ("http://127.0.0.1:9626", "http://127.0.0.1:9001/brain"):
        try:
            with urllib.request.urlopen(base + path, timeout=timeout) as r:
                return json.loads(r.read())
        except Exception:
            continue
    return None


def post_step(n: int) -> None:
    body = json.dumps({"n": n, "learn": True}).encode()
    for url in ("http://127.0.0.1:9626/step", "http://127.0.0.1:9001/brain/step"):
        try:
            req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"})
            urllib.request.urlopen(req, timeout=20).read()
            return
        except Exception:
            continue


class Live:
    """Background poller so the GL loop never blocks on HTTP."""

    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.state: dict | None = None
        self.grid: np.ndarray | None = None
        self.error: str | None = None
        self.stop = False
        self.t = threading.Thread(target=self._run, daemon=True)
        self.t.start()

    def _run(self) -> None:
        while not self.stop:
            s = get_json("/state")
            tx = get_json("/texture")
            g = None
            if tx and tx.get("data"):
                try:
                    raw = base64.b64decode(tx["data"])
                    n = int(tx.get("size", 64))
                    g = np.frombuffer(raw, dtype=np.uint8)[: n * n].reshape(n, n)
                except Exception:
                    g = None
            with self.lock:
                if s:
                    self.state = s
                    self.error = None
                else:
                    self.error = "brain unreachable"
                if g is not None:
                    self.grid = g
            time.sleep(2.0)

    def snapshot(self):
        with self.lock:
            return self.state, self.grid, self.error


def make_texture() -> int:
    tex = gl.glGenTextures(1)
    gl.glBindTexture(gl.GL_TEXTURE_2D, tex)
    gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, gl.GL_NEAREST)
    gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, gl.GL_NEAREST)
    gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_WRAP_S, gl.GL_CLAMP_TO_EDGE)
    gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_WRAP_T, gl.GL_CLAMP_TO_EDGE)
    return tex


def upload(tex: int, grid: np.ndarray) -> None:
    n = grid.shape[0]
    rgba = np.empty((n, n, 4), dtype=np.uint8)
    rgba[..., 0] = (20 + grid * 0.42).astype(np.uint8)
    rgba[..., 1] = (8 + grid * 0.72).astype(np.uint8)
    rgba[..., 2] = (40 + grid * 0.84).astype(np.uint8)
    rgba[..., 3] = 255
    gl.glBindTexture(gl.GL_TEXTURE_2D, tex)
    gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, gl.GL_RGBA, n, n, 0,
                    gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, rgba.tobytes())


def topmost(hwnd: int) -> None:
    HWND_TOPMOST, SWP_NOMOVE, SWP_NOSIZE = -1, 0x0002, 0x0001
    ctypes.windll.user32.SetWindowPos(int(hwnd), HWND_TOPMOST, 0, 0, 0, 0,
                                      SWP_NOMOVE | SWP_NOSIZE)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--no-topmost", action="store_true")
    ap.add_argument("--scale", type=float, default=1.0)
    a = ap.parse_args()
    log(f"start scale={a.scale} topmost={not a.no_topmost}")

    if not glfw.init():
        log("ERROR glfw.init failed")
        return 1
    glfw.window_hint(glfw.DECORATED, glfw.FALSE)
    glfw.window_hint(glfw.FLOATING, glfw.TRUE)
    glfw.window_hint(glfw.TRANSPARENT_FRAMEBUFFER, glfw.TRUE)
    glfw.window_hint(glfw.RESIZABLE, glfw.FALSE)
    glfw.window_hint(glfw.SAMPLES, 16)
    win = glfw.create_window(int(W * a.scale), int(H * a.scale), "ABRASAX HUD", None, None)
    if not win:
        log("ERROR create_window failed")
        glfw.terminate()
        return 1
    glfw.make_context_current(win)
    glfw.swap_interval(1)
    if not a.no_topmost:
        try:
            topmost(glfw.get_win32_window(win))
        except Exception as exc:
            log(f"topmost failed: {exc}")

    imgui.create_context()
    style = imgui.get_style()
    style.window_rounding = 14
    style.frame_rounding = 6
    style.window_padding = (14, 12)
    style.item_spacing = (8, 6)
    style.colors[imgui.COLOR_WINDOW_BACKGROUND] = (0.043, 0.043, 0.070, 0.90)
    style.colors[imgui.COLOR_TEXT] = (0.843, 0.843, 0.894, 1.0)
    style.colors[imgui.COLOR_TEXT_DISABLED] = (0.49, 0.49, 0.58, 1.0)
    style.colors[imgui.COLOR_BUTTON] = (0.082, 0.082, 0.122, 1.0)
    style.colors[imgui.COLOR_BUTTON_HOVERED] = (0.153, 0.133, 0.259, 1.0)
    style.colors[imgui.COLOR_BUTTON_ACTIVE] = ACCENT
    style.colors[imgui.COLOR_BORDER] = (0.137, 0.137, 0.227, 1.0)
    style.colors[imgui.COLOR_FRAME_BACKGROUND] = (0.082, 0.082, 0.122, 1.0)
    style.colors[imgui.COLOR_CHECK_MARK] = ACCENT
    renderer = GlfwRenderer(win, attach_callbacks=False)

    live = Live()
    tex = make_texture()
    last_upload = 0.0
    visible = True
    dragging = False
    drag_off = (0.0, 0.0)

    def on_key(_w, key, _sc, action, _mods):
        nonlocal visible
        if action != glfw.PRESS:
            return
        ctrl = glfw.get_key(_w, glfw.KEY_LEFT_CONTROL) == glfw.PRESS or \
               glfw.get_key(_w, glfw.KEY_RIGHT_CONTROL) == glfw.PRESS
        if ctrl and key == glfw.KEY_H:
            visible = not visible
            glfw.set_window_attrib(win, glfw.FLOATING, visible)
            if visible:
                glfw.show_window(win)
                if not a.no_topmost:
                    topmost(glfw.get_win32_window(win))
            else:
                glfw.hide_window(win)
        elif ctrl and key == glfw.KEY_T:
            glfw.set_window_attrib(win, glfw.FLOATING,
                                   not glfw.get_window_attrib(win, glfw.FLOATING))
        elif key == glfw.KEY_ESCAPE:
            glfw.set_window_should_close(win, True)

    glfw.set_key_callback(win, on_key)

    frames = 0
    while not glfw.window_should_close(win):
        glfw.poll_events()
        renderer.process_inputs()
        fb_w, fb_h = glfw.get_framebuffer_size(win)
        gl.glViewport(0, 0, fb_w, fb_h)
        gl.glClearColor(0.0, 0.0, 0.0, 0.0)
        gl.glClear(gl.GL_COLOR_BUFFER_BIT)

        imgui.new_frame()
        imgui.set_next_window_position(0, 0)
        imgui.set_next_window_size(fb_w, fb_h)
        flags = (imgui.WINDOW_NO_TITLE_BAR | imgui.WINDOW_NO_RESIZE |
                 imgui.WINDOW_NO_MOVE | imgui.WINDOW_NO_SCROLLBAR |
                 imgui.WINDOW_NO_COLLAPSE | imgui.WINDOW_NO_SAVED_SETTINGS |
                 imgui.WINDOW_NO_BRING_TO_FRONT_ON_FOCUS)
        imgui.begin("hud", flags=flags)

        state, grid, err = live.snapshot()
        syn = (state or {}).get("synapses") or {}
        gpu = (state or {}).get("gpu") or {}
        io = imgui.get_io()

        imgui.push_style_color(imgui.COLOR_TEXT, *ACCENT)
        imgui.text("ABRASAX // HUD")
        imgui.pop_style_color()
        imgui.same_line()
        imgui.push_style_color(imgui.COLOR_TEXT, *(BAD if err else OK))
        imgui.text("●" if not err else "○")
        imgui.pop_style_color()
        imgui.same_line()
        imgui.push_style_color(imgui.COLOR_TEXT, 0.49, 0.49, 0.58, 1.0)
        imgui.text(err or f"{(state or {}).get('backend','n/a')}")
        imgui.pop_style_color()

        imgui.separator()
        avail_w = imgui.get_content_region_available()[0]
        half = (avail_w - 12) / 2

        imgui.begin_child("tex", width=half, height=half + 12, border=False)
        if grid is not None and time.time() - last_upload > 1.5:
            upload(tex, grid)
            last_upload = time.time()
        if grid is not None:
            imgui.image(tex, half - 6, half - 6)
        else:
            imgui.text_disabled("no field")
        imgui.end_child()

        imgui.same_line()
        imgui.begin_child("stats", width=0, height=half + 12, border=False)
        rows = [
            ("steps", f"{(state or {}).get('steps','—')}"),
            ("nodes", f"{(state or {}).get('nodes','—'):,}" if (state or {}).get("nodes") else "—"),
            ("synapses", f"{syn.get('edges','—'):,}" if syn.get("edges") else "—"),
            ("reciprocal", f"{syn.get('reciprocal_directed_frac','—')}"),
            ("inhibitory", f"{syn.get('inhibitory_edge_frac','—')}"),
            ("hubs→50%", f"{syn.get('top_cell_frac_for_50pct_of_synapses','—')}"),
            ("modulator", f"{syn.get('modulator_total','—')}"),
            ("mean state", f"{(state or {}).get('mean_state','—')}"),
        ]
        for k, v in rows:
            imgui.push_style_color(imgui.COLOR_TEXT, 0.49, 0.49, 0.58, 1.0)
            imgui.text(k)
            imgui.pop_style_color()
            imgui.same_line(half - 92)
            imgui.text(str(v))
        imgui.end_child()

        imgui.spacing()
        if imgui.button("step 1", width=78):
            threading.Thread(target=post_step, args=(1,), daemon=True).start()
        imgui.same_line()
        if imgui.button("step 25", width=78):
            threading.Thread(target=post_step, args=(25,), daemon=True).start()
        imgui.same_line()
        if imgui.button("refresh", width=78):
            pass  # poller refreshes continuously
        imgui.same_line()
        imgui.text_disabled(f"{(state or {}).get('grid_sha256','')[:12]}")

        imgui.separator()
        imgui.push_style_color(imgui.COLOR_TEXT, 0.49, 0.49, 0.58, 1.0)
        imgui.text(f"fly v783  139,255 neurons · 54.5M synapses · recip 0.266   |   "
                   f"ptr {io.mouse_pos[0]:.0f},{io.mouse_pos[1]:.0f}")
        imgui.pop_style_color()

        # drag the whole panel by empty space
        if imgui.is_mouse_dragging(0) and not imgui.is_any_item_active():
            mx, my = glfw.get_cursor_pos(win)
            wx, wy = glfw.get_window_pos(win)
            if not dragging:
                dragging = True
                drag_off = (mx, my)
            glfw.set_window_pos(win, int(wx + mx - drag_off[0]), int(wy + my - drag_off[1]))
        else:
            dragging = False

        imgui.end()
        imgui.render()
        renderer.render(imgui.get_draw_data())
        glfw.swap_buffers(win)
        frames += 1

    live.stop = True
    renderer.shutdown()
    glfw.terminate()
    log(f"exit after {frames} frames")
    return 0


if __name__ == "__main__":
    sys.exit(main())

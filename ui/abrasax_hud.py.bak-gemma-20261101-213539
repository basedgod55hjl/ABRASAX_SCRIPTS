def log(msg: str) -> None:
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    with LOG_PATH.open("a", encoding="utf-8") as fh:
        fh.write(f"{stamp} {msg}\n")


def get_ex_style(hwnd: int) -> int:
    return int(_get_long(wt.HWND(hwnd), GWL_EXSTYLE))


def set_click_through(hwnd: int, on: bool) -> int:
    """Set/clear WS_EX_TRANSPARENT so the mouse reaches the desktop below."""
    ex = get_ex_style(hwnd)
    new = (ex | WS_EX_TRANSPARENT) if on else (ex & ~WS_EX_TRANSPARENT)
    if new != ex:
        _set_long(wt.HWND(hwnd), GWL_EXSTYLE, new)
    _user32.SetWindowPos(wt.HWND(hwnd), None, 0, 0, 0, 0,
                         SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER |
                         SWP_NOACTIVATE | SWP_FRAMECHANGED)
    return get_ex_style(hwnd)


def register_hotkey(hid: int, mods: int, vk: int) -> bool:
    ok = bool(_user32.RegisterHotKey(None, hid, mods | MOD_NOREPEAT, vk))
    if not ok:
        log(f"hotkey {hid} register failed err={ctypes.get_last_error()}")
    return ok


def unregister_hotkey(hid: int) -> None:
    _user32.UnregisterHotKey(None, hid)


def pump_hotkeys() -> list[int]:
    """Pull only WM_HOTKEY out of the thread queue; leave GLFW's messages."""
    ids: list[int] = []
    msg = wt.MSG()
    while _user32.PeekMessageW(ctypes.byref(msg), None, WM_HOTKEY, WM_HOTKEY, 1):
        ids.append(int(msg.wParam))
    return ids



DEFAULT_CFG = {"x": None, "y": None, "scale": None, "click_through": False}


def load_config() -> dict:
    cfg = dict(DEFAULT_CFG)
    try:
        if CFG_PATH.exists():
            data = json.loads(CFG_PATH.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                for key in DEFAULT_CFG:
                    if key in data:
                        cfg[key] = data[key]
    except Exception as exc:
        log(f"config load failed ({exc.__class__.__name__}: {exc}) - using defaults")
    return cfg


def save_config(cfg: dict) -> None:
    CFG_PATH.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "x": cfg.get("x"),
        "y": cfg.get("y"),
        "scale": round(float(cfg.get("scale") or 1.0), 3),
        "click_through": bool(cfg.get("click_through")),
        "updated": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "note": "ABRASAX HUD v2 window state; delete to fall back to auto placement",
    }
    tmp = CFG_PATH.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    tmp.replace(CFG_PATH)


# -- brain facade -----------------------------------------------------------
def get_json(path: str, timeout: float = 4.0):
    for base in ("http://127.0.0.1:9626", "http://127.0.0.1:9001/brain"):
        try:
            with urllib.request.urlopen(base + path, timeout=timeout) as r:
                return json.loads(r.read())
        except Exception:
            continue
    return None


def post_step(n: int) -> None:
    body = json.dumps({"n": n, "learn": True}).encode()
    for url in ("http://127.0.0.1:9626/step", "http://127.0.0.1:9001/brain/step"):
        try:
            req = urllib.request.Request(url, data=body,
                                         headers={"Content-Type": "application/json"})
            urllib.request.urlopen(req, timeout=20).read()
            return
        except Exception:
            continue


def read_services() -> list[dict]:
    """ops-state.json -> services, failures first so red dots lead the row."""
    try:
        data = json.loads(OPS_STATE.read_text(encoding="utf-8"))
    except Exception:
        return []
    up = [str(s) for s in (data.get("services_up") or [])]
    down = [str(s) for s in (data.get("services_down") or [])]
    return [{"name": n, "up": False} for n in down] + \
           [{"name": n, "up": True} for n in up]


class Live:
    """Background poller so the GL loop never blocks on HTTP or disk."""

    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.state: dict | None = None
        self.grid: np.ndarray | None = None
        self.services: list[dict] = []
        self.error: str | None = None
        self.stop = False
        self._kick = threading.Event()
        self.t = threading.Thread(target=self._run, name="hud-live", daemon=True)
        self.t.start()

    def kick(self) -> None:
        self._kick.set()

    def _run(self) -> None:
        while not self.stop:
            s = get_json("/state")
            tx = get_json("/texture")
            services = read_services()
            g = None
            if tx and tx.get("data"):
                try:
                    raw = base64.b64decode(tx["data"])
                    n = int(tx.get("size", 64))
                    g = np.frombuffer(raw, dtype=np.uint8)[: n * n].reshape(n, n)
                except Exception:
                    g = None
            with self.lock:
                if s:
                    self.state = s
                    self.error = None
                else:
                    self.error = "brain unreachable"
                if g is not None:
                    self.grid = g
                self.services = services
            self._kick.wait(2.0)
            self._kick.clear()

    def snapshot(self):
        with self.lock:
            return self.state, self.grid, self.error, list(self.services)


class Chat:
    """One chat turn at a time, on a worker thread."""

    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.pending = False
        self.reply = ""
        self.error = ""
        self.prompt = ""
        self.latency = 0.0
        self.serial = 0

    def send(self, text: str) -> bool:
        text = (text or "").strip()
        with self.lock:
            if self.pending or not text:
                return False
            self.pending = True
            self.error = ""
            self.prompt = text
        log(f"chat send model={CHAT_MODEL_WIRE} chars={len(text)}")
        threading.Thread(target=self._run, args=(text,), name="hud-chat",
                         daemon=True).start()
        return True

    def _run(self, text: str) -> None:
        t0 = time.time()
        try:
            payload = {
                "model": CHAT_MODEL_WIRE,
                "messages": [{"role": "user", "content": text}],
                "max_tokens": CHAT_MAX_TOKENS,
                "temperature": 0.7,
                "stream": False,
            }
            req = urllib.request.Request(
                CHAT_URL, data=json.dumps(payload).encode(),
                headers={"Content-Type": "application/json"},
            )
            with urllib.request.urlopen(req, timeout=120) as resp:
                data = json.loads(resp.read())
            choices = data.get("choices") or [{}]
            msg = choices[0].get("message") or {}
            content = (msg.get("content") or choices[0].get("text") or "").strip()
            if not content:
                raise RuntimeError("gateway returned an empty message")
            took = time.time() - t0
            with self.lock:
                self.reply = content
                self.error = ""
                self.pending = False
                self.latency = took
                self.serial += 1
            log(f"chat ok {len(content)} chars in {took:.2f}s "
                f"model={data.get('model', CHAT_MODEL)}")
        except urllib.error.HTTPError as exc:
            body = ""
            try:
                body = exc.read()[:300].decode("utf-8", "replace")
            except Exception:
                pass
            with self.lock:
                self.error = f"HTTP {exc.code}: {body or exc.reason}"
                self.pending = False
            log(f"chat fail HTTP {exc.code} {body[:160]}")
        except Exception as exc:
            with self.lock:
                self.error = f"{exc.__class__.__name__}: {exc}"
                self.pending = False
            log(f"chat fail {exc.__class__.__name__}: {exc}")

    def snapshot(self):
        with self.lock:
            return (self.pending, self.reply, self.error, self.latency, self.serial)


# -- GL helpers -------------------------------------------------------------
def make_texture() -> int:
    tex = gl.glGenTextures(1)
    gl.glBindTexture(gl.GL_TEXTURE_2D, tex)
    gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MIN_FILTER, gl.GL_NEAREST)
    gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_MAG_FILTER, gl.GL_NEAREST)
    gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_WRAP_S, gl.GL_CLAMP_TO_EDGE)
    gl.glTexParameteri(gl.GL_TEXTURE_2D, gl.GL_TEXTURE_WRAP_T, gl.GL_CLAMP_TO_EDGE)
    return tex


def upload(tex: int, grid: np.ndarray) -> None:
    n = grid.shape[0]
    rgba = np.empty((n, n, 4), dtype=np.uint8)
    rgba[..., 0] = (20 + grid * 0.42).astype(np.uint8)
    rgba[..., 1] = (8 + grid * 0.72).astype(np.uint8)
    rgba[..., 2] = (40 + grid * 0.84).astype(np.uint8)
    rgba[..., 3] = 255
    gl.glBindTexture(gl.GL_TEXTURE_2D, tex)
    gl.glTexImage2D(gl.GL_TEXTURE_2D, 0, gl.GL_RGBA, n, n, 0,
                    gl.GL_RGBA, gl.GL_UNSIGNED_BYTE, rgba.tobytes())


def topmost(hwnd: int) -> None:
    _user32.SetWindowPos(wt.HWND(hwnd), HWND_TOPMOST, 0, 0, 0, 0,
                         SWP_NOMOVE | SWP_NOSIZE)


def monitor_for(index: int | None):
    monitors = glfw.get_monitors()
    if not monitors:
        return None
    if index is None:
        return glfw.get_primary_monitor() or monitors[0]
    return monitors[max(1, min(int(index), len(monitors))) - 1]


def place_top_right(win, monitor, w: int, h: int) -> tuple[int, int]:
    if monitor is None:
        glfw.set_window_pos(win, 40, 40)
        return 40, 40
    wx, wy, ww, wh = glfw.get_monitor_workarea(monitor)
    x, y = int(wx + ww - w - 16), int(wy + 16)
    glfw.set_window_pos(win, x, y)
    return x, y


def position_visible(x: int, y: int, w: int, h: int) -> bool:
    for mon in glfw.get_monitors():
        mx, my, mw, mh = glfw.get_monitor_workarea(mon)
        ix = min(x + w, mx + mw) - max(x, mx)
        iy = min(y + h, my + mh) - max(y, my)
        if ix >= 80 and iy >= 40:
            return True
    return False



def draw_service_dots(services: list[dict], scale: float) -> None:
    """Ten small dots: red = down, green = up, hollow = unused slot."""
    slots = 10
    radius = 4.0 * scale
    step = 14.0 * scale
    draw_list = imgui.get_window_draw_list()
    x0, y0 = imgui.get_cursor_screen_pos()
    cy = y0 + 7.0 * scale
    for i in range(slots):
        cx = x0 + radius + i * step
        svc = services[i] if i < len(services) else None
        if svc is None:
            draw_list.add_circle(cx, cy, radius, imgui.get_color_u32_rgba(*BORDER),
                                 12, 1.0 * scale)
            label = "unused slot"
        else:
            col = OK if svc["up"] else BAD
            draw_list.add_circle_filled(cx, cy, radius,
                                        imgui.get_color_u32_rgba(*col), 12)
            label = f"{svc['name']} — {'up' if svc['up'] else 'DOWN'}"
        if imgui.is_mouse_hovering_rect(cx - radius - 2 * scale,
                                        cy - radius - 2 * scale,
                                        cx + radius + 2 * scale,
                                        cy + radius + 2 * scale):
            imgui.set_tooltip(label)
    imgui.dummy(slots * step + 4 * scale, 14.0 * scale)
    imgui.same_line()
    up = sum(1 for s in services if s["up"])
    down = len(services) - up
    imgui.push_style_color(imgui.COLOR_TEXT, *(MUTED if down == 0 else BAD))
    imgui.text(f"{up} up / {down} down")
    imgui.pop_style_color()


def selftest_chat(prompt: str) -> int:
    chat = Chat()
    if not chat.send(prompt):
        print("send refused", file=sys.stderr)
        return 2
    deadline = time.time() + 130
    while time.time() < deadline:
        pending, reply, error, took, _ = chat.snapshot()
        if not pending:
            print(f"latency={took:.2f}s")
            if error:
                print(f"error={error}")
                return 1
            print(f"reply={reply}")
            return 0
        time.sleep(0.2)
    print("timeout", file=sys.stderr)
    return 3


def main() -> int:
    ap = argparse.ArgumentParser(description="ABRASAX HUD v2")
    ap.add_argument("--no-topmost", action="store_true")
    ap.add_argument("--scale", type=float, default=None,
                    help="UI scale; default: saved config, else auto (1.35 on >=3000px primary)")
    ap.add_argument("--monitor", type=int, default=None,
                    help="1-based monitor index; top-right of that work area")
    ap.add_argument("--ask", type=str, default=None, help="send one chat line at startup")
    ap.add_argument("--frames", type=int, default=0, help="debug: exit after N frames")
    ap.add_argument("--prove", action="store_true",
                    help="debug: click-through on at frame 60, off at frame 600")
    ap.add_argument("--selftest-chat", type=str, default=None,
                    help="no window: send one chat turn and print the reply")
    a = ap.parse_args()

    if a.selftest_chat:
        return selftest_chat(a.selftest_chat)

    cfg = load_config()
    started = time.time()

    if not glfw.init():
        log("ERROR glfw.init failed")
        return 1

    primary = glfw.get_primary_monitor()
    primary_w = getattr(getattr(glfw.get_video_mode(primary) if primary else None,
                                "size", None), "width", 1920)
    auto_scale = 1.35 if primary_w >= 3000 else 1.0
    if a.scale is not None:
        scale, scale_src = a.scale, "arg"
    elif cfg.get("scale"):
        scale, scale_src = float(cfg["scale"]), "config"
    else:
        scale, scale_src = auto_scale, f"auto(primary={primary_w}px)"
    scale = max(0.75, min(3.0, float(scale)))

    w, h = int(BASE_W * scale), int(BASE_H * scale)
    log(f"start scale={scale:.2f} ({scale_src}) size={w}x{h} "
        f"config={'yes' if CFG_PATH.exists() else 'no'} monitor={a.monitor} "
        f"topmost={not a.no_topmost}")

    glfw.window_hint(glfw.DECORATED, glfw.FALSE)
    glfw.window_hint(glfw.FLOATING, glfw.TRUE)
    glfw.window_hint(glfw.TRANSPARENT_FRAMEBUFFER, glfw.TRUE)
    glfw.window_hint(glfw.RESIZABLE, glfw.FALSE)
    glfw.window_hint(glfw.SAMPLES, 16)
    win = glfw.create_window(w, h, "ABRASAX HUD", None, None)
    if not win:
        log("ERROR create_window failed")
        glfw.terminate()
        return 1
    glfw.make_context_current(win)
    glfw.swap_interval(1)
    hwnd = glfw.get_win32_window(win)
    if not a.no_topmost:
        try:
            topmost(hwnd)
        except Exception as exc:
            log(f"topmost failed: {exc}")

    # placement: --monitor > saved position > primary work area top-right
    mon = monitor_for(a.monitor)
    if a.monitor is not None:
        x, y = place_top_right(win, mon, w, h)
        log(f"placement monitor={a.monitor} work={glfw.get_monitor_workarea(mon)} "
            f"pos={x},{y}")
    elif cfg.get("x") is not None and cfg.get("y") is not None:
        x, y = int(cfg["x"]), int(cfg["y"])
        if position_visible(x, y, w, h):
            glfw.set_window_pos(win, x, y)
            log(f"config restored pos={x},{y} scale={scale:.2f} "
                f"click_through={bool(cfg.get('click_through'))}")
        else:
            old = (x, y)
            x, y = place_top_right(win, mon, w, h)
            log(f"config pos {old} offscreen -> reset to {x},{y}")
    else:
        x, y = place_top_right(win, mon, w, h)
        log(f"config default pos={x},{y} work={glfw.get_monitor_workarea(mon)}")

    imgui.create_context()
    io = imgui.get_io()
    font_loaded = False
    if Path(FONT_FILE).exists():
        try:
            io.fonts.add_font_from_file_ttf(FONT_FILE, 13.0 * scale,
                                            glyph_ranges=io.fonts.get_glyph_ranges_default())
            font_loaded = True
            log(f"font consola {13.0 * scale:.1f}px")
        except Exception as exc:
            log(f"font load failed: {exc}")
    if not font_loaded:
        io.fonts.add_font_default()
        io.font_global_scale = scale
    apply_style(scale)
    renderer = GlfwRenderer(win, attach_callbacks=False)

    live = Live()
    chat = Chat()
    tex = make_texture()
    last_upload = 0.0
    visible = True
    dragging = False
    drag_off = (0.0, 0.0)
    click_through = False
    focus_chat = False
    chat_buf = ""
    last_reply_serial = 0
    last_toggle = 0.0
    hk_l = False
    hk_h = False
    frames = 0

    register_hotkey(1, MOD_CONTROL | MOD_SHIFT, VK_L)
    register_hotkey(2, MOD_CONTROL | MOD_SHIFT, VK_H)

    def save_state() -> None:
        try:
            px, py = glfw.get_window_pos(win)
            cfg.update({"x": int(px), "y": int(py), "scale": float(scale),
                        "click_through": bool(click_through)})
            save_config(cfg)
            log(f"config saved x={int(px)} y={int(py)} scale={scale:.2f} "
                f"click_through={click_through}")
        except Exception as exc:
            log(f"config save failed: {exc}")

    def apply_click_through(on: bool) -> None:
        nonlocal click_through, hk_l, last_toggle
        now = time.time()
        if now - last_toggle < 0.35:
            return
        last_toggle = now
        click_through = on
        try:
            ex = set_click_through(hwnd, on)
            log(f"click_through={on} exstyle=0x{ex & 0xFFFFFFFF:08x}")
        except Exception as exc:
            log(f"click_through failed: {exc}")
        if on and not hk_l:
            hk_l = register_hotkey(3, MOD_CONTROL, VK_L)
        elif not on and hk_l:
            unregister_hotkey(3)
            hk_l = False
        save_state()

    def set_visible(on: bool) -> None:
        nonlocal visible, hk_h, last_toggle
        now = time.time()
        if now - last_toggle < 0.35:
            return
        last_toggle = now
        visible = on
        if on:
            glfw.show_window(win)
            glfw.set_window_attrib(win, glfw.FLOATING, True)
            if not a.no_topmost:
                topmost(hwnd)
            if hk_h:
                unregister_hotkey(4)
                hk_h = False
        else:
            glfw.hide_window(win)
            if not hk_h:
                hk_h = register_hotkey(4, MOD_CONTROL, VK_H)
        log(f"visible={on}")

    def on_key(_w, key, _sc, action, _mods):
        if action != glfw.PRESS:
            return
        ctrl = (glfw.get_key(_w, glfw.KEY_LEFT_CONTROL) == glfw.PRESS or
                glfw.get_key(_w, glfw.KEY_RIGHT_CONTROL) == glfw.PRESS)
        shift = (glfw.get_key(_w, glfw.KEY_LEFT_SHIFT) == glfw.PRESS or
                 glfw.get_key(_w, glfw.KEY_RIGHT_SHIFT) == glfw.PRESS)
        if ctrl and key == glfw.KEY_L:
            apply_click_through(not click_through)
        elif ctrl and shift and key == glfw.KEY_H:
            set_visible(not visible)
        elif ctrl and key == glfw.KEY_H:
            set_visible(not visible)
        elif ctrl and key == glfw.KEY_T:
            glfw.set_window_attrib(win, glfw.FLOATING,
                                   not glfw.get_window_attrib(win, glfw.FLOATING))
        elif key == glfw.KEY_ESCAPE:
            glfw.set_window_should_close(win, True)

    glfw.set_key_callback(win, on_key)

    # restore the persisted click-through preference (adds the global escape hatch)
    if cfg.get("click_through"):
        apply_click_through(True)

    if a.ask:
        chat.send(a.ask)

    try:
        while not glfw.window_should_close(win):
            for hid in pump_hotkeys():
                if hid in (1, 3):
                    apply_click_through(not click_through)
                elif hid in (2, 4):
                    set_visible(not visible)

            glfw.poll_events()
            renderer.process_inputs()
            fb_w, fb_h = glfw.get_framebuffer_size(win)
            gl.glViewport(0, 0, fb_w, fb_h)
            gl.glClearColor(0.0, 0.0, 0.0, 0.0)
            gl.glClear(gl.GL_COLOR_BUFFER_BIT)

            imgui.new_frame()
            imgui.set_next_window_position(0, 0)
            imgui.set_next_window_size(fb_w, fb_h)
            flags = (imgui.WINDOW_NO_TITLE_BAR | imgui.WINDOW_NO_RESIZE |
                     imgui.WINDOW_NO_MOVE | imgui.WINDOW_NO_SCROLLBAR |
                     imgui.WINDOW_NO_COLLAPSE | imgui.WINDOW_NO_SAVED_SETTINGS |
                     imgui.WINDOW_NO_BRING_TO_FRONT_ON_FOCUS)
            imgui.begin("hud", flags=flags)

            state, grid, err, services = live.snapshot()
            pending, reply, chat_error, chat_took, reply_serial = chat.snapshot()
            syn = (state or {}).get("synapses") or {}
            io_ = imgui.get_io()

            # -- header --------------------------------------------------
            imgui.push_style_color(imgui.COLOR_TEXT, *ACCENT)
            imgui.text("ABRASAX // HUD")
            imgui.pop_style_color()
            imgui.same_line()
            imgui.push_style_color(imgui.COLOR_TEXT, *(BAD if err else OK))
            imgui.text("•" if not err else "×")
            imgui.pop_style_color()
            imgui.same_line()
            imgui.push_style_color(imgui.COLOR_TEXT, *MUTED)
            imgui.text(err or f"{(state or {}).get('backend', 'n/a')}")
            imgui.pop_style_color()

            imgui.separator()
            avail_w = imgui.get_content_region_available()[0]
            half = (avail_w - 12 * scale) / 2

            # -- brain field + metrics -----------------------------------
            imgui.begin_child("tex", width=half, height=half + 12 * scale, border=False)
            if grid is not None and time.time() - last_upload > 1.5:
                upload(tex, grid)
                last_upload = time.time()
            if grid is not None:
                side = half - 6 * scale
                imgui.image(tex, side, side)
            else:
                imgui.text_disabled("no field")
            imgui.end_child()

            imgui.same_line()
            imgui.begin_child("stats", width=0, height=half + 12 * scale, border=False)
            rows = [
                ("steps", f"{(state or {}).get('steps', '—')}"),
                ("nodes", f"{(state or {}).get('nodes', '—'):,}"
                 if (state or {}).get("nodes") else "—"),
                ("synapses", f"{syn.get('edges', '—'):,}" if syn.get("edges") else "—"),
                ("reciprocal", f"{syn.get('reciprocal_directed_frac', '—')}"),
                ("inhibitory", f"{syn.get('inhibitory_edge_frac', '—')}"),
                ("hubs 50%", f"{syn.get('top_cell_frac_for_50pct_of_synapses', '—')}"),
                ("modulator", f"{syn.get('modulator_total', '—')}"),
                ("mean state", f"{(state or {}).get('mean_state', '—')}"),
            ]
            for k, v in rows:
                imgui.push_style_color(imgui.COLOR_TEXT, *MUTED)
                imgui.text(k)
                imgui.pop_style_color()
                imgui.same_line(half - 92 * scale)
                imgui.text(str(v))
            imgui.end_child()

            # -- step buttons --------------------------------------------
            imgui.spacing()
            bw = 78 * scale
            if imgui.button("step 1", width=bw):
                threading.Thread(target=post_step, args=(1,), daemon=True).start()
            imgui.same_line()
            if imgui.button("step 25", width=bw):
                threading.Thread(target=post_step, args=(25,), daemon=True).start()
            imgui.same_line()
            if imgui.button("refresh", width=bw):
                live.kick()
            imgui.same_line()
            imgui.push_style_color(imgui.COLOR_TEXT, *MUTED)
            imgui.text(f"{(state or {}).get('grid_sha256', '')[:10]}")
            imgui.pop_style_color()

            # -- service dots --------------------------------------------
            draw_service_dots(services, scale)

            # -- chat ----------------------------------------------------
            imgui.separator()
            imgui.push_style_color(imgui.COLOR_TEXT, *MUTED)
            imgui.text(f"chat · :9001 · {CHAT_MODEL}")
            if chat_took and not pending and not chat_error:
                imgui.same_line()
                imgui.text_disabled(f"{chat_took:.1f}s")
            imgui.pop_style_color()

            btn_w = 54 * scale
            if focus_chat:
                imgui.set_keyboard_focus_here()
                focus_chat = False
            imgui.push_item_width(avail_w - btn_w - 8 * scale)
            changed, chat_buf = imgui.input_text("##chat", chat_buf, 512,
                                                 imgui.INPUT_TEXT_ENTER_RETURNS_TRUE)
            imgui.pop_item_width()
            imgui.same_line()
            pressed = imgui.button("send", width=btn_w)
            if (pressed or changed) and chat_buf.strip():
                if chat.send(chat_buf):
                    chat_buf = ""
                    focus_chat = True

            reply_h = 96.0 * scale
            imgui.begin_child("reply", width=0, height=reply_h, border=True)
            imgui.push_text_wrap_pos(0.0)
            if pending:
                imgui.push_style_color(imgui.COLOR_TEXT, *ACCENT)
                imgui.text("thinking…")
                imgui.pop_style_color()
            elif chat_error:
                imgui.push_style_color(imgui.COLOR_TEXT, *BAD)
                imgui.text(f"error: {chat_error}")
                imgui.pop_style_color()
            elif reply:
                imgui.text(reply)
                if reply_serial != last_reply_serial:
                    last_reply_serial = reply_serial
                    imgui.set_scroll_y(imgui.get_scroll_max_y())
            else:
                imgui.text_disabled("ask the runtime — enter sends")
            imgui.pop_text_wrap_pos()
            imgui.end_child()

            # -- footer --------------------------------------------------
            imgui.separator()
            imgui.push_style_color(imgui.COLOR_TEXT, *(WARN if click_through else MUTED))
            imgui.text("[PASSTHROUGH]" if click_through else "[interactive]")
            imgui.pop_style_color()
            imgui.same_line()
            imgui.push_style_color(imgui.COLOR_TEXT, *MUTED)
            imgui.text("CTRL+L toggle · CTRL+H hide · ESC quit")
            imgui.pop_style_color()
            nup = sum(1 for s in services if s["up"])
            imgui.push_style_color(imgui.COLOR_TEXT, *MUTED)
            imgui.text(f"{nup} up · scale {scale:.2f} · uptime "
                       f"{int(time.time() - started)}s · "
                       f"ptr {io_.mouse_pos[0]:.0f},{io_.mouse_pos[1]:.0f}")
            imgui.pop_style_color()

            content_h = (imgui.get_cursor_pos()[1] +
                         imgui.get_style().window_padding[1] + 2)

            # drag the whole panel by empty space (only when interactive)
            if imgui.is_mouse_dragging(0) and not imgui.is_any_item_active():
                mx, my = glfw.get_cursor_pos(win)
                wx, wy = glfw.get_window_pos(win)
                if not dragging:
                    dragging = True
                    drag_off = (mx, my)
                glfw.set_window_pos(win, int(wx + mx - drag_off[0]),
                                    int(wy + my - drag_off[1]))
            elif dragging:
                dragging = False
                save_state()

            imgui.end()
            imgui.render()
            renderer.render(imgui.get_draw_data())
            glfw.swap_buffers(win)
            frames += 1

            if a.prove and frames == 60:
                apply_click_through(True)
            elif a.prove and frames == 600:
                apply_click_through(False)

            # grow once if the content does not fit (font/scale drift insurance)
            if content_h > fb_h - 2 and frames <= 60:
                new_h = int(math.ceil(fb_h + (content_h - fb_h) + 4))
                log(f"autosize content={content_h:.1f} fb={fb_h} -> {fb_w}x{new_h}")
                glfw.set_window_size(win, fb_w, new_h)

            if a.frames and frames >= a.frames:
                break
    finally:
        live.stop = True
        save_state()
        for hid in (1, 2, 3, 4):
            unregister_hotkey(hid)
        try:
            renderer.shutdown()
        except Exception:
            pass
        glfw.terminate()
        log(f"exit after {frames} frames")

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except Exception:
        log("FATAL\n" + traceback.format_exc())
        raise

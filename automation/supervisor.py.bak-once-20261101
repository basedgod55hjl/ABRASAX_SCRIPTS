def _codec_cmd() -> list[str]:
    """Run the built DLL through the dotnet host.

    The native apphost (codec_gateway.exe) inherits the Low mandatory integrity label of
    TOOLS/source-tools, so HTTP.sys rejects its HttpListener session (error 6). `dotnet <dll>`
    runs from the user profile and binds fine. Prefer Release, then Debug, then apphost.
